// CampusBite Prisma Database Schema (PostgreSQL Production Specification)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  KITCHEN_STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DietaryType {
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
  EGG
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MOCK
  UPI
  CARD
  ONLINE
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  phone        String?
  passwordHash String
  role         Role        @default(STUDENT)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orders        Order[]
  notifications Notification[]
  statusChanges OrderStatusHistory[]

  @@index([email])
  @@index([role])
}

model FoodCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  foodItems   FoodItem[]
}

model FoodItem {
  id              String       @id @default(uuid())
  categoryId      String
  category        FoodCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  description     String
  price           Float
  imageUrl        String
  ingredients     String
  dietaryType     DietaryType  @default(VEGETARIAN)
  available       Boolean      @default(true)
  stockQuantity   Int          @default(50)
  preparationTime Int          @default(15)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orderItems OrderItem[]

  @@index([categoryId])
  @@index([dietaryType])
  @@index([available])
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount   Float
  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(PENDING)
  pickupTime    DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         OrderItem[]
  payment       Payment?
  statusHistory OrderStatusHistory[]
  notifications Notification[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])
  quantity   Int
  unitPrice  Float
  subtotal   Float

  @@index([orderId])
  @@index([foodItemId])
}

model Payment {
  id                   String        @id @default(uuid())
  orderId              String        @unique
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactionReference String        @unique
  amount               Float
  method               PaymentMethod @default(MOCK)
  status               PaymentStatus @default(PENDING)
  paidAt               DateTime?
  gatewayResponse      String?
  createdAt            DateTime      @default(now())

  @@index([transactionReference])
  @@index([status])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  changedBy String?
  user      User?       @relation(fields: [changedBy], references: [id], onDelete: SetNull)
  notes     String?
  timestamp DateTime    @default(now())

  @@index([orderId])
  @@index([timestamp])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
